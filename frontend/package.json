    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
