NODE_ENV=development
WORKER_ID=worker-1

# AIS Provider type: "websocket" for real provider, "mock" for development
AIS_PROVIDER_TYPE=mock

# Required when AIS_PROVIDER_TYPE=websocket
# Example providers: AISStream, MarineTraffic, VesselFinder
# Check each provider's terms and pricing before use
AIS_PROVIDER_URL=
AIS_PROVIDER_API_KEY=

# Bounding boxes for AIS subscription (lat_min,lon_min,lat_max,lon_max)
# Multiple boxes separated by semicolons
# Default: Indonesia coverage
AIS_BOUNDING_BOXES=-11,95,6,141

# Backend internal API URL (must include /api/internal/v1 prefix)
BACKEND_INTERNAL_URL=http://localhost:8000/api/internal/v1

# Internal worker token (must match backend INTERNAL_WORKER_TOKEN)
BACKEND_INTERNAL_TOKEN=

# Whitelist refresh interval in seconds
WHITELIST_REFRESH_SECONDS=300

# Maximum acceptable message age in seconds
MAX_MESSAGE_AGE_SECONDS=300

# Exponential backoff settings in milliseconds
BACKOFF_MIN_MS=1000
BACKOFF_MAX_MS=60000

# Maximum delivery queue size (drops oldest when full)
DELIVERY_QUEUE_MAX=1000

# Log level: debug, info, warn, error
LOG_LEVEL=info
